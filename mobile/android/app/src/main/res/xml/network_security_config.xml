<?xml version="1.0" encoding="utf-8"?>
<!-- 自托管多半是自签证书：用户在系统设置里装了 Roami 的 CA 就直接信；没装的走 TOFU（首次询问、记指纹） -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
